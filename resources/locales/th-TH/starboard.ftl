help-starboard_userstats = ดูสถิติติดดาวของผู้ใช้ที่ระบุ
# max.length: 100
help-starboardset = ตั้งค่าระบบบอร์ดดาวเด่น
# max.length: 100
help-starboardset_setup = ติดตั้งหรือปรับเปลี่ยนการตั้งค่าบอร์ดดาวเด่นในเซิร์ฟเวอร์นี้
# max.length: 100
help-starboardset_reset = ลบบอร์ดดาวเด่นและข้อมูลทั้งหมดทิ้ง
# max.length: 100
help-starboardset_toggle = เปิดหรือปิดการใช้งานบอร์ดดาวเด่น
# max.length: 100
help-starboardset_channel = เปลี่ยนช่องที่จะใช้แสดงบอร์ดดาวเด่น
# max.length: 100
help-starboardset_emoji = เปลี่ยนอีโมจิที่ใช้กดให้ดาว
