help-starboardset_threshold = เปลี่ยนจำนวนดาวขั้นต่ำเพื่อขึ้นบอร์ด
# max.length: 100
help-starboardset_selfstar = เปิด/ปิด สิทธิ์ให้ผู้ใช้กดให้ดาวข้อความของตัวเองได้
# max.length: 100
help-starboardset_ignore = จัดการช่องที่ต้องการละเว้น (ไม่นับดาว)
