# max.length: 100
help-starboardset_nsfw = เปิด/ปิด ให้สามารถกดติดดาวข้อความจากช่อง NSFW ได้หรือไม่
# max.length: 100
help-starboardset_bots = เปิด/ปิด ให้สามารถกดติดดาวข้อความของบอทได้หรือไม่
# max.length: 100
help-starboardset_webhooks = เปิด/ปิด ให้สามารถกดติดดาวข้อความจาก Webhook ได้หรือไม่
# max.length: 100
help-starboardset_removethreshold = ตั้งค่าจำนวนดาวขั้นต่ำที่จะลบข้อความออกจากบอร์ดดาวเด่น (หากดาวลดลง)
# max.length: 100
help-starboardset_autoreact = [Silver+] เปิด/ปิด การใส่อีโมจิให้อัตโนมัติเมื่อข้อความขึ้นบอร์ดดาวเด่น
# max.length: 100
help-starboardset_lock = [Silver+] เปิด/ปิด การล็อกข้อความหลังขึ้นบอร์ดดาวเด่น (ป้องกันการกดเพิ่ม/ลดดาว)
# max.length: 100
help-starboardset_display = ตั้งค่ารูปแบบการแสดงผลของข้อความบอร์ดดาวเด่น
# max.length: 100
help-starboardset_allowchannel = จัดการรายการช่องที่อนุญาต (Whitelist) หากตั้งไว้ จะนับดาวเฉพาะช่องเหล่านี้เท่านั้น
# max.length: 100
help-starboardset_role = [Silver+] จัดการข้อจำกัดยศของผู้พิมพ์ข้อความและผู้กดให้ดาว
# max.length: 100
help-starboardset_message = จัดการข้อความบนบอร์ดดาวเด่นแบบรายข้อความ (ปักหมุด, แช่แข็ง, นับดาวใหม่)
# max.length: 100
help-starboardset_milestone = [Silver+] ตั้งค่าความสำเร็จและเกณฑ์การฉลองเมื่อถึงยอดดาวที่กำหนด
# max.length: 100
help-starboardset_embed = [Silver+] ตั้งค่าการตกแต่งรูปลักษณ์ของข้อความ (Embed)
# max.length: 100
help-starboardset_blocklist = [Silver+] จัดการรายการบล็อก (Blocklist) สำหรับบอร์ดดาวเด่น
# max.length: 100
help-starboardset_cooldown = [Silver+] ตั้งเวลาคูลดาวน์ระหว่างการกดดาวเพื่อป้องกันการสแปมโหวต

# ==========================================
# Parameter Descriptions
# ==========================================

starboard_leaderboard-parameter-category-description = สิ่งที่ต้องการให้แสดง: ข้อความยอดนิยม, คนกดดาวให้เยอะสุด หรือผู้สร้างข้อความติดดาวสูงสุด
starboard_userstats-parameter-user-description = ผู้ใช้ที่คุณต้องการดูสถิติ
starboardset_setup-parameter-channel-description = ช่องที่จะใช้แสดงข้อความที่ติดดาวแล้ว
starboardset_setup-parameter-emoji-description = อีโมจิที่ใช้กดติดดาว (ค่าเริ่มต้น: ⭐)
starboardset_setup-parameter-threshold-description = จำนวนดาวขั้นต่ำที่ต้องได้รับ (ค่าเริ่มต้น: 1)
starboardset_toggle-parameter-enabled-description = เปิดหรือปิดใช้งานบอร์ดดาวเด่น
starboardset_channel-parameter-channel-description = ช่องบอร์ดดาวเด่นแห่งใหม่
starboardset_emoji-parameter-emoji-description = อีโมจิที่จะใช้สำหรับกดติดดาวข้อความ
starboardset_threshold-parameter-threshold-description = จำนวนดาวที่ต้องใช้เพื่อให้ข้อความขึ้นบอร์ดดาวเด่น (1-100)
starboardset_selfstar-parameter-allow-description = อนุญาตให้ผู้ใช้กดดาวข้อความของตัวเองได้
starboardset_ignore-parameter-action-description = เพิ่ม, ลบ หรือแสดงรายการช่องที่ละเว้น
starboardset_ignore-parameter-channel-description = ช่องที่ต้องการเพิ่ม/ลบ (จำเป็นต้องระบุสำหรับการเพิ่ม/ลบ)
starboardset_maxage-parameter-days-description = อายุสูงสุดของข้อความ (เป็นวัน) ที่อนุญาตให้ติดดาวได้ (ใส่ 0 เพื่อปิด)
starboardset_color-parameter-color-description = รหัสโค้ดสี Hex (เช่น #FFAC33 หรือ FFAC33)
starboardset_nsfw-parameter-allow-description = อนุญาตให้ติดดาวข้อความจากช่อง NSFW
starboardset_bots-parameter-allow-description = อนุญาตให้ติดดาวข้อความของบอท
starboardset_webhooks-parameter-allow-description = อนุญาตให้ติดดาวข้อความจาก Webhook (เช่น PluralKit, Tupperbox)
starboardset_removethreshold-parameter-threshold-description = หากจำนวนดาวลดลงจนต่ำกว่าค่านี้ ระบบจะลบข้อความออกจากบอร์ด (ใส่ 0 เพื่อปิด)
starboardset_autoreact-parameter-enable-description = บอทจะกดส่งอีโมจีดาวเพิ่มให้ทันทีเมื่อข้อความขึ้นบอร์ดดาวเด่น
starboardset_lock-parameter-enable-description = ล็อกข้อความทันทีที่ขึ้นบอร์ดดาวเด่น (เพื่อป้องกันไม่ให้กดดาวเพิ่มได้อีก)
starboardset_display-parameter-style-description = รูปแบบการแสดงผลผู้เขียนข้อความ
starboardset_display-parameter-attachments-description = แสดงไฟล์แนบใน Embed
starboardset_display-parameter-replies-description = แสดงข้อความอ้างอิง (Reply) ด้วย
starboardset_display-parameter-jumpbutton-description = แสดงปุ่มลิงก์วาร์ปไปยังข้อความต้นฉบับ
starboardset_allowchannel-parameter-action-description = เพิ่ม, ลบ หรือล้างรายการช่องที่อนุญาต (Whitelist)
starboardset_allowchannel-parameter-channel-description = ช่องที่ต้องการเพิ่ม/ลบ (ไม่ต้องระบุหากกดล้างรายการ)
starboardset_role-parameter-role_type-description = รายการยศที่ต้องการแก้ไข
starboardset_role-parameter-action-description = เพิ่ม, ลบ หรือล้างรายการยศ
starboardset_role-parameter-role-description = ยศที่ต้องการเพิ่ม/ลบ (ไม่ต้องระบุหากกดล้างรายการ)
starboardset_message-parameter-action-description = คำสั่งที่จะดำเนินการกับข้อความ
starboardset_message-parameter-message-description = ลิงก์ข้อความหรือ Message ID
starboardset_milestone-parameter-enabled-description = เปิดหรือปิดการแสดงยินดีเมื่อถึงความสำเร็จ (Milestone)
starboardset_milestone-parameter-notify_author-description = ส่งข้อความส่วนตัว (DM) ไปหาผู้เขียนเมื่อข้อความถึงระดับความสำเร็จ
starboardset_milestone-parameter-announce_channel-description = ช่องสำหรับประกาศความสำเร็จ (หากเว้นว่างไว้จะส่งลงช่องบอร์ดดาวเด่น)
starboardset_milestone-parameter-thresholds-description = จำนวนดาวสำหรับความสำเร็จ โดยใช้เครื่องหมายจุลภาคคั่น (เช่น '10,25,50,100')
starboardset_embed-parameter-show_timestamp-description = แสดงเวลาของข้อความต้นฉบับ
starboardset_embed-parameter-compact_mode-description = ใช้รูปแบบ Embed แบบย่อ (ย่อส่วนการแสดงผล)
starboardset_embed-parameter-footer-description = รูปแบบข้อความท้ายภาพ (Footer) แบบกำหนดเอง (ใช้ตัวแปร { "{" }stars{ "}" }, { "{" }channel{ "}" }, { "{" }emoji{ "}" }, { "{" }author{ "}" }, { "{" }date{ "}" } ฯลฯ ได้)
starboardset_blocklist-parameter-action-description = ดำเนินการ: เพิ่ม, ลบ หรือแสดงรายชื่อผู้ใช้ที่ถูกบล็อก
starboardset_blocklist-parameter-user-description = ผู้ใช้ที่ต้องการบล็อกหรือปลดบล็อก (จำเป็นต้องระบุเมื่อสั่งเพิ่ม/ลบ)
starboardset_blocklist-parameter-block_type-description = บล็อกไม่ให้กดดาว หรือบล็อกไม่ให้ข้อความของคนๆ นั้นถูกกดดาว
starboardset_cooldown-parameter-seconds-description = เวลาคูลดาวน์เป็นวินาที (ใส่ 0 เพื่อปิด)
starboardset_cooldown-parameter-per_message-description = หากเลือก True คูลดาวน์จะนับแยกเป็นรายข้อความ; หากเลือก False จะเป็นคูลดาวน์รวมทั้งเซิร์ฟเวอร์

